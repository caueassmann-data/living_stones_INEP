{
  "raw_root": "latam_education_data/raw",
  "raw_is_junction": true,
  "sources": {
    "world_bank": {
      "grain": "country_year_indicator",
      "path": "raw/regional/world_bank_edstats/edstats_latam_dropout_related_2000_2025.csv",
      "into_indicators_mart": true
    },
    "unicef": {
      "grain": "country_year_indicator_sex",
      "path": "raw/regional/unicef_education/unicef_oos_completion_latam_sdmx.csv",
      "into_indicators_mart": true
    },
    "bid": {
      "grain": "country_year_indicator_disagg",
      "paths": [
        "raw/regional/bid_social_indicators/early_school_dropout_rate.csv",
        "raw/regional/bid_social_indicators/early_leavers_share_census.csv"
      ],
      "into_indicators_mart": true
    },
    "unesco": {
      "grain": "country_year_indicator",
      "path": "raw/regional/unesco_uis/SDG_extracted/SDG_DATA_NATIONAL.csv",
      "labels": "raw/regional/unesco_uis/SDG_extracted/SDG_LABEL.csv",
      "into_indicators_mart": true
    },
    "cepal": {
      "grain": "country_year_indicator_disagg",
      "path": "raw/regional/cepalstat/",
      "into_indicators_mart": true
    },
    "uruguay": {
      "grain": "department_year_grade",
      "path": "raw/national/uruguay/abandono_intermitente_primaria.csv",
      "into_indicators_mart": true,
      "geo_level": "subnational"
    },
    "colombia_medellin": {
      "grain": "school_year_sex",
      "path": "raw/national/colombia/desercion_educativa_medellin/desercion_educativa.csv",
      "into_indicators_mart": false,
      "into_school_risk_co": true
    },
    "argentina": {
      "grain": "jurisdiction_year",
      "path": "raw/national/argentina/tasa_abandono_interanual/",
      "into_indicators_mart": true,
      "note": "Excel official abandonment rates"
    },
    "brasil_censo": {
      "grain": "school_year",
      "path": "raw/national/brasil/",
      "into_indicators_mart": false,
      "into_school_risk_br": true
    }
  },
  "staging_root": "latam_education_data/staging",
  "marts_root": "latam_education_data/marts",
  "dq_root": "latam_education_data/dq"
}
